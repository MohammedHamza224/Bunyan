# =============================================================
# ContractorFlow — Environment Variables Example
# Copy this file to .env and fill in actual values.
# NEVER commit .env to source control.
# =============================================================

# --- Database ---
DATABASE_URL="postgresql://contractorflow:changeme@localhost:5432/contractorflow_dev"

# --- JWT ---
JWT_ACCESS_SECRET="change-this-to-a-random-256-bit-secret"
JWT_REFRESH_SECRET="change-this-to-another-random-256-bit-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Server ---
PORT=3001
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173"

# --- File Storage ---
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3001/api

# --- ZATCA Integration (Phase 5 - fill in later) ---
# ZATCA_ENVIRONMENT=sandbox
# ZATCA_API_URL=
# ZATCA_OTP=
# ZATCA_CERT_PATH=
# ZATCA_PRIVATE_KEY_PATH=

# --- Logging ---
LOG_LEVEL=info
